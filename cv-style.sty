% Change the colours if you want to
\definecolor{Primary}{HTML}{145FA5}
%\definecolor{Primary}{HTML}{5BABBB}
\definecolor{NonBlue}{HTML}{5FA0DD}
%\definecolor{NonBlue}{HTML}{92DCE5}
\definecolor{SlateGrey}{HTML}{18314f}
%\definecolor{SlateGrey}{HTML}{2E2E2E}
\definecolor{LightGrey}{HTML}{666666}
%\definecolor{LightGrey}{HTML}{666666}
\colorlet{heading}{Primary}
\colorlet{accent}{Primary}
\colorlet{subheading}{NonBlue}
\colorlet{emphasis}{SlateGrey}
\colorlet{body}{LightGrey}

% Keep subsection headings aligned with the document margin.
\renewcommand{\cvsubsection}[1]{%
    \par\smallskip\noindent
    {\color{emphasis}\large\bfseries #1\par}\medskip
}

% Use the lighter accent for structural groups within a CV section.
\newcommand{\cvgroupheading}[1]{%
    \cvsubsection{\color{subheading}#1}%
}

% Change the bullets for itemize and rating marker
% for \cvskill if you want to
\renewcommand{\itemmarker}{{\small\textbullet}}
\renewcommand{\ratingmarker}{\faCircle}

\newcommand{\latex}{\LaTeX\xspace}

\newcommand{\cvblock}[4]{
    \makebox[\linewidth][c]{
        \parbox[l]{0.5\linewidth}{
            {{\large\color{emphasis}#1}\par
            \smallskip
            \textbf{\color{accent}#2}}\par
            \smallskip
        }
        \makebox[0.5\linewidth][c]{
            \small
            \begin{minipage}{0.2\linewidth}
                \raggedright \faCalendar \hspace{0.5em}#3
            \end{minipage}
            %\parbox[r]{0.3\linewidth}{\faCalendar \hspace{0.5em}#3}%
            \ifstrequal{#4}{}{}{\parbox[r]{0.2\linewidth}{\faMapMarker\hspace{0.5em}#4}}\par
        }
    }
}

\newcommand{\cvskillblock}[2]{
    \makebox[\linewidth][c]{
        \parbox[c]{0.4\linewidth}{
            \noindent\cvsubsection{#1}
            \smallskip
        }
        \parbox[l]{0.6\linewidth}{
            #2
            \smallskip
        }
    }
}

\newcommand{\cvskilldivider}{%
    \textcolor{body!30}{\hdashrule{\linewidth}{0.6pt}{0.5ex}}\smallskip
}

\newcommand{\calendaritem}[1]{
    \small
    \begin{minipage}{\linewidth}
        
    \end{minipage}
    %\small\parbox[l]{\linewidth}{ \faCalendar \hspace{0.1em} {#1}}
}

\newcommand{\notesymbol}{\faInfoCircle}
\newcommand{\worknote}{
    \small \notesymbol \hspace{0.5em} Work done during the studies
}
